        },
        "cname": {
          "maxLength": 150,
          "type": "string",
          "nullable": true,
          "example": "servername.it.helsinki.fi."
        },
        "flags": {
          "maxLength": 50,
          "type": "string",
          "example": "wol-aadalib"
        },
        "routingscope": {
          "maxLength": 40,
          "type": "string",
          "example": "public"
        }
      }
    },
